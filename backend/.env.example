# ══════════════════════════════════════════════════════════════════
# ⚠️  SECURITY WARNING — READ BEFORE DEPLOYING TO PRODUCTION
# This file is a TEMPLATE committed to version control; every value below
# is a placeholder, not a real secret. Copy it to a local `.env`
# (`cp .env.example .env` — `.env` itself is git-ignored, never commit it)
# and replace AT MINIMUM the following three values with your own
# cryptographically random, high-entropy strings before any production
# deployment. Never reuse the placeholder text below in production —
# anyone who has read this file (i.e. anyone with access to the repo)
# already knows it, which would let them forge JWTs / gateway callbacks:
#   - JWT_ACCESS_SECRET
#   - JWT_REFRESH_SECRET
#   - GATEWAY_CALLBACK_SECRET
# Generate a strong value for each with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ══════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins. REQUIRED — there is no
# "*" fallback (see src/config/env.js); the app fails to start without this
# set to your real frontend origin(s) in every environment, including prod.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://jolfa_user:jolfa_pass@localhost:5432/jolfa_market?schema=public"

# TEST-CLEANUP-ONLY. Not read by any code under src/ and not part of the
# production application runtime — only tests/helpers/maintenance-client.js
# reads this, for the ledger test suites' afterAll cleanup (deleting
# journals/ledger_entries/ledger_accounts rows, which the application role
# jolfa_app deliberately cannot do). Must authenticate as the
# `jolfa_maintenance` Postgres role (see
# p2_6_step2f_maintenance_privilege_addendum.sql), not jolfa_app and not an
# admin/superuser. Leave unset outside of running the ledger test suites.
# MAINTENANCE_DATABASE_URL="postgresql://jolfa_maintenance:<MAINTENANCE_PASSWORD>@localhost:5432/jolfa_market?schema=public"

# ─── Auth / JWT ────────────────────────────────────────────
# ⚠️ MUST be replaced with a strong random secret before production — never
# ship the placeholder value below. See warning banner at the top of this file.
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
# ⚠️ MUST be replaced with a strong random secret before production — never
# ship the placeholder value below. See warning banner at the top of this file.
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ─── Uploads ───────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Logging ───────────────────────────────────────────────
# Directory for Winston's rotated log files (src/utils/logger.js). Optional —
# defaults to "logs" relative to the process cwd if unset.
LOG_DIR=logs

# ─── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Login protection ───────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ─── Password reset ──────────────────────────────────────────
RESET_TOKEN_EXPIRES_MIN=30

# ─── Email / Mobile verification ─────────────────────────────
VERIFICATION_TOKEN_EXPIRES_MIN=15
VERIFICATION_RESEND_COOLDOWN_SEC=60

# ─── OTP (registration / login / password-reset) ──────────────
# Not yet read by src/config/env.js — reserved here for the upcoming
# service-layer OTP flows built on top of the new otp_codes table.
OTP_CODE_EXPIRES_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ─── Payment gateway callback (HMAC placeholder — see gateway.middleware.js) ──
# Required for /payments/gateway/callback to accept anything at all (it
# fails closed without this). Swap the verification scheme in
# src/middlewares/gateway.middleware.js for the real provider's mechanism
# once one is chosen; this is a generic, vendor-agnostic stand-in.
# ⚠️ MUST be replaced with a strong random secret before production — never
# ship the placeholder value below. See warning banner at the top of this file.
GATEWAY_CALLBACK_SECRET=change_this_gateway_callback_secret_in_production

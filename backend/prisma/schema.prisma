// ════════════════════════════════════════════════════════════════════
// Jolfa Market — Prisma Schema
// Modular e-commerce marketplace: Auth, Users, Roles, Products,
// Categories, Stores, Sellers, Orders, Payments, Cart, Wishlist,
// Reviews, Support Chat, Notifications, Admin.
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── Auth / Users / Roles ────────────────────────────

enum RoleKey {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

model Role {
  id          String     @id @default(uuid())
  key         RoleKey    @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("roles")
}

model Permission {
  id          String            @id @default(uuid())
  key         String            @unique // e.g. "products:create", "orders:read:own"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  // Set by the general admin-panel "Delete User" action (DELETE /users/:id,
  // users.service.js#deleteUser) — a distinct terminal state from
  // SUSPENDED/BANNED ("Block User"), since a deleted account also has its
  // mobile/email freed for re-registration and can never be reactivated
  // (see the no-restore-flow rule already enforced in updateStatus()).
  DELETED
}

model User {
  id             String       @id @default(uuid())
  name           String
  mobile         String       @unique
  email          String?      @unique
  passwordHash   String
  avatarUrl      String?
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  status         UserStatus   @default(ACTIVE)
  lastLoginAt    DateTime?
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // Soft-delete marker, set by either of two admin-panel actions:
  //   - DELETE /admin/sellers/:sellerId (removeSeller() in sellers.service.js) — seller-specific
  //   - DELETE /users/:id (deleteUser() in users.service.js) — general, any role
  // The row itself is never SQL-DELETEd — a user's Orders/Payments/Store/
  // Product rows can carry history that must survive (see products.service.js
  // remove()'s identical "never hard-delete anything with order history"
  // rule) — so deletion instead marks the account (`status: DELETED`) and
  // stamps when/by whom. Plain string, no relation, matching the existing
  // reviewedById convention on Product / SellerApplication.
  deletedAt      DateTime?
  deletedById    String?

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  verificationTokens   VerificationToken[]
  addresses            Address[]
  store                Store?
  sellerApplication    SellerApplication?
  cart                 Cart?
  wishlist             WishlistItem[]
  reviews              Review[]
  orders               Order[]
  wallet               Wallet?
  supportConversations SupportConversation[]
  storeConversations   StoreConversation[]    @relation("CustomerConversations")
  storeMessages        StoreMessage[]
  supportMessages      SupportMessage[]
  notificationDismissals NotificationDismissal[]
  notificationReads    NotificationRead[]
  adminActivityLogs    AdminActivityLog[]
  commissionRulesCreated CommissionRule[]
  paymentRefundsRequested PaymentRefund[]
  payoutRequests          PayoutRequest[] @relation("PayoutRequestsAsSeller")
  payoutRequestsRequested PayoutRequest[] @relation("PayoutRequestsRequested")
  payoutRequestsApproved  PayoutRequest[] @relation("PayoutRequestsApproved")
  payoutRequestsProcessed PayoutRequest[] @relation("PayoutRequestsProcessed")
  sellerPayoutLiabilities SellerPayoutLiability[]

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  // Session metadata — each refresh token IS a session (one issued per login/refresh).
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}


model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum VerificationType {
  EMAIL
  MOBILE
}


model VerificationToken {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  target    String
  tokenHash String            @unique
  used      Boolean           @default(false)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PASSWORD_RESET
}

// Stand-alone OTP store for flows that happen BEFORE a User row exists
// (registration-by-OTP) as well as flows resolved by mobile on an existing
// user (OTP login, OTP password-reset). Deliberately has NO relation to
// User — unlike VerificationToken above, which verifies an
// already-created account's email/mobile — because at REGISTER time there
// is no userId yet to attach to. All three purposes share this one table,
// keyed by (mobile, purpose); the app layer resolves/creates the User as
// appropriate for whichever purpose is being completed.
model OtpCode {
  id          String     @id @default(uuid())
  mobile      String
  purpose     OtpPurpose
  codeHash    String
  // Per-code brute-force guard (separate from the resend cooldown, which is
  // enforced in application code the same way VerificationToken's is).
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumed    Boolean    @default(false)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([mobile, purpose])
  @@map("otp_codes")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  province   String
  city       String
  addressLine String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ──────────────────────────── Stores / Sellers ────────────────────────────

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Store {
  id          String      @id @default(uuid())
  sellerId    String      @unique
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  slug        String      @unique
  categoryTag String?
  region      String?
  description String?
  logoUrl     String?
  rating      Decimal     @default(0) @db.Decimal(2, 1)
  status      StoreStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  storeProducts      StoreProduct[]
  orderItems         OrderItem[]
  storeConversations StoreConversation[]
  commissionRules    CommissionRule[]
  settlements        OrderItemSettlement[]
  payoutLiabilities  SellerPayoutLiability[]

  @@index([status])
  @@map("stores")
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model SellerApplication {
  id           String                    @id @default(uuid())
  userId       String                    @unique
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName    String
  businessInfo Json?
  documents    Json?
  status       SellerApplicationStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                  @default(now())

  @@map("seller_applications")
}

// ──────────────────────────── Categories / Products ────────────────────────────

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  icon     String?
  // Admin-controlled visibility toggle. An inactive category is hidden from
  // public browsing/filtering and can't be selected for new/edited products,
  // but existing products keep their categoryId (no cascading side effects).
  isActive Boolean    @default(true)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  commissionRules CommissionRule[]

  @@index([isActive])
  @@map("categories")
}

enum ProductType {
  RETAIL
  WHOLESALE
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

// ──────────────────────────── Product (global) / StoreProduct (store offer) ────────────────────────────
//
// Product = the platform-wide catalog entry for one physical item (an "iPhone
// 16 Pro, 256GB, Black" exists exactly once no matter how many stores sell
// it). `identityKey` is a deterministic hash of the normalized identity
// fields (name/brand/model/capacity/color — see products.service.js
// buildIdentityKey()) and is the ONLY thing that decides whether a
// newly-submitted product reuses an existing Product row or creates a new
// one. `slug` is unique too (used for the public product URL) but is NOT the
// dedup key — two stores submitting the same product with slightly
// different name casing/whitespace must still resolve to one Product.
//
// StoreProduct = one store's sellable offer of a Product: price, stock,
// moderation status, images, wholesale tiers, warranty, etc. This is what
// carts/orders/wishlist/reviews actually point at (`storeId`+`productId` is
// unique — a store can only have ONE offer per global product).
model Product {
  id             String    @id @default(uuid())
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  name           String
  slug           String    @unique
  brand          String?
  model          String?
  capacity       String?
  color          String?
  description    String?
  // Free-form spec sheet (e.g. { "چیپست": "A18 Pro", "رم": "8GB" }) — not
  // used in identityKey generation, purely descriptive.
  specifications Json?
  // Deterministic fingerprint of the normalized identity fields. UNIQUE —
  // this is the actual dedup mechanism (see point 2/3 of products.service.js).
  identityKey    String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  storeProducts StoreProduct[]
  reviews       Review[]

  @@index([categoryId])
  @@map("products")
}

model StoreProduct {
  id             String        @id @default(uuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  price          Decimal       @db.Decimal(12, 0)
  compareAtPrice Decimal?      @db.Decimal(12, 0)
  stock          Int           @default(0)
  warranty       String?
  shippingTime   String?
  // Percentage off `price`, 0-100. Purely informational/display — `price`
  // itself is always the authoritative charge amount; this does not
  // recompute price automatically.
  discount       Int?
  type           ProductType   @default(RETAIL)
  status         ProductStatus @default(PENDING)
  // Seller-controlled visibility toggle — independent from `status` (admin moderation).
  // A product can be APPROVED but temporarily hidden by its seller (isActive=false),
  // e.g. while it's out of stock or paused; toggling it does NOT require re-approval.
  isActive       Boolean       @default(true)
  reviewedById   String?
  reviewedAt     DateTime?
  // Set by moderate() when status is set to REJECTED (shown to the seller in
  // their own product list); cleared back to null on a later APPROVED moderation.
  rejectReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images        ProductImage[]
  wholesaleTiers WholesaleTier[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
  // Every public/customer listing query filters on both of these together
  // (status = APPROVED AND isActive = true) — a composite index lets that
  // filter be satisfied by a single index scan instead of one index scan
  // plus a row-by-row isActive re-check.
  @@index([status, isActive])
  @@map("store_products")
}

model ProductImage {
  id             String       @id @default(uuid())
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  url            String
  position       Int          @default(0)

  @@index([storeProductId])
  @@map("product_images")
}

model WholesaleTier {
  id             String       @id @default(uuid())
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  minQty         Int
  price          Decimal      @db.Decimal(12, 0)

  @@index([storeProductId])
  @@map("wholesale_tiers")
}

// ──────────────────────────── Cart / Wishlist ────────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id             String       @id @default(uuid())
  cartId         String
  cart           Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  qty            Int          @default(1)
  priceSnapshot  Decimal      @db.Decimal(12, 0)

  @@unique([cartId, storeProductId])
  @@map("cart_items")
}

model WishlistItem {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, storeProductId])
  @@map("wishlist_items")
}

// ──────────────────────────── Reviews ────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  status    ReviewStatus @default(APPROVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

// ──────────────────────────── Orders / Payments ────────────────────────────

// Order lifecycle only — NOT payment status (see PaymentStatus below, which
// is tracked independently on the Payment model). CONFIRMED covers "payment
// succeeded / order accepted"; a failed or refunded payment is visible on
// the Payment record without forcing the order itself backward.
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SENT
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  addressId    String?
  address      Address?    @relation(fields: [addressId], references: [id])
  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @db.Decimal(12, 0)
  shippingFee  Decimal     @db.Decimal(12, 0) @default(0)
  total        Decimal     @db.Decimal(12, 0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  settlements OrderItemSettlement[]
  refunds  PaymentRefund[]
  payoutLiabilities SellerPayoutLiability[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id])
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  nameSnapshot   String
  priceSnapshot  Decimal      @db.Decimal(12, 0)
  qty            Int

  settlement OrderItemSettlement?

  @@index([orderId])
  @@index([storeId])
  @@index([storeProductId])
  @@map("order_items")
}

enum PaymentMethod {
  WALLET
  GATEWAY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 0)
  status          PaymentStatus @default(PENDING)
  // Unique so two payment attempts (e.g. a customer retrying after an
  // abandoned/failed gateway session) can never end up sharing one ref —
  // see initGatewayPayment/confirmGateway in payments.service.js. NULL for
  // WALLET/CASH_ON_DELIVERY payments, which never carry a gateway ref;
  // Postgres allows unlimited NULLs under a unique constraint, so this
  // doesn't restrict those methods.
  transactionRef  String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  refunds PaymentRefund[]

  @@index([orderId])
  @@map("payments")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 0)
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTxType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id        String       @id @default(uuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxType
  amount    Decimal      @db.Decimal(12, 0)
  reason    String
  refId     String?
  createdAt DateTime     @default(now())

  @@index([walletId])
  @@map("wallet_transactions")
}

// ──────────────────────────── Commission Rules ────────────────────────────
//
// Commission is dynamic per-order — there is NO fixed commission percentage
// hardcoded anywhere in the application. `rate` on the applicable active
// CommissionRule (chosen by resolveCommissionRate() in
// commission-rules.service.js, see the priority ordering documented there)
// is always the source of truth. The GLOBAL default is itself a row in this
// table, not a fallback constant, and at least one active GLOBAL rule must
// exist at all times (enforced in the service layer — see
// assertNotRemovingLastActiveGlobal()).
//
// Scope semantics:
//   GLOBAL   — the platform-wide default. sellerId/categoryId must be null.
//   SELLER   — overrides GLOBAL for one Store. sellerId required, categoryId null.
//   CATEGORY — overrides GLOBAL for one Category. categoryId required, sellerId null.
//   CAMPAIGN — a time-boxed override, highest priority of all scopes while its
//              [campaignStartAt, campaignEndAt] window contains `now`. May
//              optionally be narrowed to one seller and/or one category;
//              campaignStartAt/campaignEndAt are required for this scope only.
//
// `priority` is a same-scope tie-breaker only (e.g. two simultaneously
// active CAMPAIGN rules) — it does NOT reorder the GLOBAL/CATEGORY/
// SELLER/CAMPAIGN tiers themselves, which is fixed. See resolveCommissionRate().
enum CommissionScope {
  GLOBAL
  SELLER
  CATEGORY
  CAMPAIGN
}

model CommissionRule {
  id               String          @id @default(uuid())
  scope            CommissionScope
  // Nullable FK -> Store. Required (non-null) for SELLER scope; optional
  // narrowing field for CAMPAIGN scope; must be null for GLOBAL/CATEGORY.
  sellerId         String?
  seller           Store?          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  // Nullable FK -> Category. Required (non-null) for CATEGORY scope; optional
  // narrowing field for CAMPAIGN scope; must be null for GLOBAL/SELLER.
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Only set (and only meaningful) for CAMPAIGN scope; null for every other scope.
  campaignStartAt  DateTime?
  campaignEndAt    DateTime?
  rate             Decimal         @db.Decimal(5, 2)
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])

  @@index([scope])
  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
  // Speeds up the CAMPAIGN date-window lookup in resolveCommissionRate().
  @@index([scope, isActive, campaignStartAt, campaignEndAt])

  settlements OrderItemSettlement[]

  @@map("commission_rules")
}

// ──────────────────────── Order Settlement (Seller Payout) ────────────────────────
//
// One row per OrderItem, created exactly once — the moment (and only the
// moment) that item's order makes the real SENT -> DELIVERED transition
// (see settleDeliveredOrder() in orders.service.js). `orderItemId` is
// @unique specifically so that property IS the idempotency guarantee at
// the database level: a retried/duplicated delivery confirmation can never
// create a second settlement row (and therefore can never credit a
// seller's wallet twice) for the same order item, even if the in-app
// SENT-only status guard were somehow raced.
//
// Every money/rate field here is a SNAPSHOT taken at settlement time —
// commissionRate, grossAmount, commissionAmount, and sellerEarning never
// change afterwards, even if the CommissionRule that produced them is
// later edited or deactivated. commissionRuleId is kept only for audit
// traceability (which rule fired) and is nullable / ON DELETE SET NULL so
// a rule being removed later can never take a historical settlement's
// numbers down with it.
model OrderItemSettlement {
  id     String @id @default(uuid())

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  // Denormalized from OrderItem for cheap "all settlements for this order /
  // this seller's store" queries without joining through OrderItem every time.
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  // Snapshot of the commission rate actually applied (Decimal(5,2), matches
  // CommissionRule.rate) — independent of whatever that rule's rate is today.
  commissionRate    Decimal @db.Decimal(5, 2)
  // gross = OrderItem.priceSnapshot * OrderItem.qty
  grossAmount       Decimal @db.Decimal(12, 0)
  // commission = round(gross * commissionRate / 100)
  commissionAmount  Decimal @db.Decimal(12, 0)
  // sellerEarning = gross - commission — this is exactly what gets credited
  // to the seller's wallet.
  sellerEarning     Decimal @db.Decimal(12, 0)

  // Traceability only — never re-read to recompute past settlements.
  commissionRuleId String?
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  settledAt DateTime @default(now())
  createdAt DateTime @default(now())

  reversals OrderItemSettlementReversal[]

  @@index([orderId])
  @@index([storeId])
  @@index([commissionRuleId])
  @@map("order_item_settlements")
}

// ──────────────────────── Refund / Cancellation (Phase 4) ────────────────────────
//
// Purely additive on top of Phase 0-3: the original Payment/OrderItemSettlement
// rows are NEVER mutated by a refund (except Payment.status, which only ever
// moves SUCCESS -> REFUNDED once fully refunded — see payments.service.js).
// Every refund, whether it moved real money (WALLET) or is still awaiting a
// manual gateway confirmation (GATEWAY), gets exactly one PaymentRefund row.
enum RefundStatus {
  REQUESTED // GATEWAY refund recorded, no outbound gateway API called yet — awaiting manual confirmation via markGatewayRefundProcessed().
  PROCESSED // Money has actually moved: WALLET refunds are PROCESSED immediately; GATEWAY refunds become PROCESSED only via the manual confirmation endpoint.
  FAILED
}

// P2.4 — which kind of refund this is. Required (no default) on every
// production call site of refundWallet/refundGateway (payments.service.js)
// so the distinction can never be silently guessed later — see those
// functions' own doc comments. Nullable at the schema level ONLY because
// PaymentRefund rows created before this column existed must not be
// backfilled by inference (see the 20260813000000_payment_refund_origin_ledger_status
// migration comment and orders.service.js#markGatewayRefundProcessed's
// legacy-row branch).
enum PaymentRefundOrigin {
  PRE_DELIVERY_CANCELLATION
  POST_DELIVERY_REFUND
}

// P2.4 — whether this refund's financial event is safe to represent in the
// Ledger, and if so, whether it already has been. Only meaningful for
// origin = POST_DELIVERY_REFUND (POSTABLE / SHORTFALL_HELD are decided once,
// inside the same transaction as the seller-wallet clawback attempt, by
// orders.service.js#refundDeliveredOrder — never recomputed later from
// current Wallet.balance). POSTED marks that the corresponding Ledger
// journal (REFUND for POST_DELIVERY_REFUND, PAYMENT_REVERSED for
// PRE_DELIVERY_CANCELLATION) has actually been posted, in
// markGatewayRefundProcessed or the WALLET-refund path that posts
// immediately. Nullable for the same legacy-row reason as
// PaymentRefundOrigin above.
enum PaymentRefundLedgerStatus {
  POSTABLE
  SHORTFALL_HELD
  POSTED
}

model PaymentRefund {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount Decimal      @db.Decimal(12, 0)
  status RefundStatus @default(REQUESTED)
  reason String?

  // P2.4 — see the PaymentRefundOrigin / PaymentRefundLedgerStatus enum doc
  // comments above. Both nullable: legacy rows created before this column
  // existed are left NULL, never backfilled by inference (see
  // markGatewayRefundProcessed's legacy-row branch, which deliberately
  // skips automated Ledger posting whenever either is NULL).
  origin       PaymentRefundOrigin?
  ledgerStatus PaymentRefundLedgerStatus?

  // DB-level idempotency guard (see payments.service.js#refundWallet /
  // refundGateway): a second call with the same key returns the existing
  // row instead of moving money or inserting a duplicate.
  idempotencyKey String @unique

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  reversals   OrderItemSettlementReversal[]
  // P2.4 — every SellerPayoutLiability created as a direct result of THIS
  // refund's seller-wallet clawback shortfall (see
  // SellerPayoutLiability.refundId's own doc comment below).
  liabilities SellerPayoutLiability[]

  @@index([paymentId])
  @@index([orderId])
  @@map("payment_refunds")
}

// One row per (OrderItemSettlement, PaymentRefund) — a reversal of PART or
// ALL of that settlement's quantity. The original OrderItemSettlement is
// never updated/deleted; summing this table's refundedQty per settlementId
// is how "how much of this item has already been refunded" is derived (see
// orders.service.js#refundDeliveredOrder), the same append-only-ledger
// pattern OrderItemSettlement itself uses for the original sale.
model OrderItemSettlementReversal {
  id           String              @id @default(uuid())
  settlementId String
  settlement   OrderItemSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  refundId     String
  refund       PaymentRefund       @relation(fields: [refundId], references: [id], onDelete: Restrict)

  refundedQty              Int
  refundedGrossAmount      Decimal @db.Decimal(12, 0)
  // Bookkeeping only — recorded so the platform's commission ledger
  // reflects the reversal, but no wallet movement is ever made for
  // platform commission itself (see decision doc).
  refundedCommissionAmount Decimal @db.Decimal(12, 0)
  refundedSellerEarning    Decimal @db.Decimal(12, 0)

  reason    String?
  createdAt DateTime @default(now())

  @@index([settlementId])
  @@index([refundId])
  @@map("order_item_settlement_reversals")
}

// ──────────────────────── Seller Payout / Withdrawal (Phase 5) ────────────────────────
//
// Purely additive on top of Phase 1-4: nothing here mutates Wallet's shape,
// OrderItemSettlement, or PaymentRefund. A payout only ever moves money
// that has already been credited into a seller's Wallet.balance by
// settleDeliveredOrder (Phase 2/3) — this module never talks to Order/
// OrderItem/Payment directly.
//
// State machine (enforced in payouts.service.js, not here):
//   REQUESTED -> APPROVED  -> PROCESSED   (terminal success)
//   REQUESTED -> REJECTED               (terminal, funds returned)
//   APPROVED  -> FAILED                 (terminal, funds returned)
//
// Money lifecycle: the requested `amount` is atomically reserved (debited)
// out of the seller's Wallet.balance the moment the row is created
// (REQUESTED) — the same atomic conditional-updateMany compare-and-swap
// pattern used everywhere else in this codebase for wallet mutations (see
// payments.service.js#payWithWallet, orders.service.js#settleDeliveredOrder
// / #refundDeliveredOrder). REJECTED and FAILED both credit that reserved
// amount back to the seller's wallet; PROCESSED does not (the money has
// genuinely left the platform by then). Every debit/credit against a
// payout has its own WalletTransaction row (append-only ledger, mirrors
// every other wallet-affecting flow).
enum PayoutStatus {
  REQUESTED  // Amount reserved (debited) from the seller's wallet; awaiting admin review.
  APPROVED   // Admin approved; awaiting off-platform bank transfer.
  PROCESSED  // Bank transfer confirmed complete — terminal, no wallet movement (money already left the wallet at REQUESTED).
  REJECTED   // Admin rejected before approval — terminal, reserved amount returned to wallet.
  FAILED     // Approved but the off-platform transfer failed — terminal, reserved amount returned to wallet.
}

model PayoutRequest {
  id       String       @id @default(uuid())
  sellerId String
  // Same convention as Store.sellerId / Wallet.userId — the seller IS a
  // User row (one Store per seller, @unique), not a separate Seller model.
  seller   User         @relation("PayoutRequestsAsSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  amount   Decimal      @db.Decimal(12, 0)
  status   PayoutStatus @default(REQUESTED)

  // DB-level idempotency guard (same pattern as PaymentRefund.idempotencyKey
  // — see payments.service.js#refundWallet). A client may supply its own
  // key so a retried/double-submitted withdrawal request is a safe no-op
  // instead of reserving the amount twice; the service generates one
  // server-side when the client doesn't provide it.
  idempotencyKey String @unique

  // Bank destination, stored as a point-in-time SNAPSHOT on the request
  // itself (per Phase 5 spec — no separate BankAccount model yet). Changing
  // a seller's bank details later never alters an already-submitted
  // PayoutRequest's destination.
  bankAccountHolder String
  bankIban          String
  bankCardNumber    String?
  bankName          String?

  requestedById String
  requestedBy   User      @relation("PayoutRequestsRequested", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?     @relation("PayoutRequestsApproved", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt    DateTime?
  processedById String?
  processedBy   User?     @relation("PayoutRequestsProcessed", fields: [processedById], references: [id], onDelete: Restrict)
  processedAt   DateTime?
  // Set on REJECTED (optional admin note) and FAILED (why the off-platform
  // transfer didn't go through). Left null for REQUESTED/APPROVED/PROCESSED.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
  @@map("payout_requests")
}

// ──────────────────── Seller Payout Liability (Phase 5 fix) ────────────────────
//
// Purely additive. Handles the gap where a customer refund's seller-wallet
// clawback (orders.service.js#refundDeliveredOrder) can't be fully covered
// because the seller already withdrew the money via a PayoutRequest.
// Wallet.balance must NEVER go negative (see every wallet mutation in this
// codebase), so refundDeliveredOrder collects whatever IS currently in the
// seller's wallet (down to zero) and records whatever's left uncollected
// here instead of blocking the customer's refund on it.
//
// One row per (order, store) shortfall — created only when a clawback
// couldn't be fully collected. Append-only in the sense that no row is
// ever deleted or re-pointed at a different order/store; `amount` is the
// REMAINING outstanding balance of the liability and is additively
// decremented in place as it is recovered (Phase 6:
// payout-liabilities.service.js#recoverSellerLiabilities), the same
// "field holds the current remaining amount" convention as Wallet.balance
// itself. `status` flips OUTSTANDING -> RECOVERED (never backwards) only
// once `amount` reaches zero, with `recoveredAt` stamped at that moment.
// Recovery is automatic-only, driven from future settleDeliveredOrder
// earnings — see recoverSellerLiabilities for the FIFO algorithm.
enum SellerLiabilityStatus {
  OUTSTANDING
  RECOVERED
}

model SellerPayoutLiability {
  id       String @id @default(uuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  // P2.4 — the PaymentRefund whose seller-wallet clawback attempt produced
  // this shortfall (set inside the same transaction as the clawback, in
  // orders.service.js#refundDeliveredOrder, BEFORE this row is created —
  // never associated later by orderId alone, which would be ambiguous
  // across multiple refunds / multiple stores / partial refunds on the
  // same order). Nullable + onDelete: SetNull for the same legacy-row
  // reason as PaymentRefund.origin/ledgerStatus: liability rows created
  // before this column existed are left NULL, never backfilled by
  // inference.
  refundId String?
  refund   PaymentRefund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  // The uncollected portion of one store's refund clawback for this order —
  // i.e. amount - (whatever the wallet actually had to give at refund time).
  amount Decimal                @db.Decimal(12, 0)
  status SellerLiabilityStatus  @default(OUTSTANDING)
  reason String?

  // P2.9 — the shortfall amount AT CREATION TIME, immutable thereafter.
  // `amount` above is deliberately the MUTABLE remaining balance
  // (decremented in place by recoverSellerLiabilities' FIFO recovery — see
  // that field's own doc comment and payout-liabilities.service.js), so it
  // can no longer answer "what was this liability's shortfall when its
  // REFUND Journal was posted" once any recovery has happened against it.
  // originalAmount exists solely to answer that question — most critically
  // for a GATEWAY refund, whose REFUND Journal is posted at
  // markGatewayRefundProcessed confirmation time, arbitrarily later than
  // this row's creation, by which point `amount` may have already been
  // partially or fully recovered. Nullable + never backfilled, same
  // legacy-row convention as refundId/PaymentRefund.origin/ledgerStatus:
  // NULL means this row predates P2.9 (or, in principle, has no
  // receivable-backed REFUND leg at all) and remains a legacy liability
  // recovered against PLATFORM_CASH forever (see
  // ledgerReceivableEntryId's own comment and
  // payout-liabilities.service.js#recoverSellerLiabilities' branch).
  originalAmount Decimal? @db.Decimal(12, 0)

  // P2.9 — the exact LedgerEntry representing THIS liability's own
  // PLATFORM_RECEIVABLE DEBIT leg inside its REFUND Journal — deliberately
  // NOT a reference to the Journal itself. A single PaymentRefund produces
  // exactly one REFUND Journal (Journal.eventId = PaymentRefund.id), but a
  // multi-seller/multi-store shortfall refund can post MULTIPLE
  // PLATFORM_RECEIVABLE legs into that same Journal, all against the same
  // singleton PLATFORM_RECEIVABLE Account — so a Journal-level reference
  // cannot, on its own, identify which specific leg/amount belongs to
  // which liability whenever two shortfalls in the same refund happen to
  // share an amount. Pointing at the LedgerEntry row itself removes that
  // ambiguity with no LedgerEntry schema change (postJournal already
  // returns entries in the same order as the legs it was given). NULL for
  // every legacy/historical liability (never backfilled — see
  // originalAmount's own comment) and for any liability whose REFUND
  // Journal has not been posted yet (e.g. a GATEWAY shortfall still
  // awaiting markGatewayRefundProcessed confirmation). Never used to
  // mutate Ledger history — journals/ledger_entries remain
  // insert-only/immutable at the DB layer regardless (see the
  // 20260815000000_ledger_immutability_trigger migration).
  ledgerReceivableEntryId String?
  ledgerReceivableEntry   LedgerEntry? @relation(fields: [ledgerReceivableEntryId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())
  recoveredAt DateTime?

  @@index([sellerId])
  @@index([orderId])
  @@index([refundId])
  @@index([status])
  // Additive Phase 6 index: recoverSellerLiabilities' FIFO scan
  // (WHERE sellerId = ? AND status = 'OUTSTANDING' ORDER BY createdAt ASC)
  // and the admin listing's sellerId+status filter both hit this shape.
  @@index([sellerId, status, createdAt])
  // P2.9 — DB-enforced version of the "at most one shortfall liability per
  // (order, store) per refund" invariant that refundDeliveredOrder's Pass 2
  // already relies on implicitly (its storeDebits Map creates at most one
  // liability per storeId per call). refundId is nullable — Postgres
  // treats every NULL as distinct under a unique index, so this never
  // constrains legacy rows (refundId IS NULL) against each other. Required
  // by P2.9's store-scoped Gateway reconstruction (markGatewayRefundProcessed),
  // which looks up exactly one liability per (refundId, storeId) to recover
  // that store's immutable originalAmount.
  @@unique([refundId, storeId])
  @@index([ledgerReceivableEntryId])
  @@map("seller_payout_liabilities")
}

// ──────────────────────── Ledger — Double-Entry Foundation (P2.4 Phase 1) ────────────────────────
//
// Models per the P2.2/P2.3 design decision document ("Ledger + Wallet Owner
// Architecture + Platform Account"). This block adds the Account/Journal/
// LedgerEntry tables and their enums. Per the P2.6 Runtime Ledger
// Integration Audit (8/8 flows verified PASS), Ledger runtime integration
// is already wired into payments.service.js / orders.service.js /
// payouts.service.js / payout-liabilities.service.js for the relevant
// financial flows (PAYMENT, WALLET PAYMENT, SETTLEMENT, REFUND, PAYOUT
// RESERVE, PAYOUT RELEASE, PAYOUT PROCESSED, LIABILITY RECOVERY). No
// existing model, column, enum value, or row is touched by this block.
//
// Ownership model (design doc §3): an Account is keyed by
// (ownerType, ownerId, currency), NOT by a User foreign key. This is
// deliberate:
//   - CUSTOMER_WALLET / SELLER_WALLET: ownerId = User.id, but stored as a
//     plain string, not a relation — so a single User can hold two
//     completely independent Account rows (one per role) even though
//     today's Wallet.userId is @unique and only allows one row per User
//     (see design doc §2.2/§3.1 on the Wallet.userId / Store.sellerId
//     overlap this is meant to fix).
//   - PLATFORM_REVENUE / PLATFORM_CASH / PAYMENT_GATEWAY_CLEARING /
//     PAYOUT_CLEARING: ownerId is a fixed platform constant (see
//     PLATFORM_LEDGER_OWNER_ID below), never a synthetic/fabricated User
//     row — the schema intentionally has no FK here so platform accounts
//     never need a fake User to satisfy a foreign key (design doc §3.3).

// The fixed, well-known ownerId used for every PLATFORM_* Account.
// Not a User.id — there is no "platform user" anywhere in this schema, and
// none should ever be fabricated to satisfy this field. Application code in
// a later phase is expected to reference this exact literal when
// creating/looking up platform accounts.
//   PLATFORM_LEDGER_OWNER_ID = "PLATFORM"

enum LedgerAccountOwnerType {
  CUSTOMER_WALLET          // ownerId = User.id (the customer). Funded by PaymentRefund credits.
  SELLER_WALLET            // ownerId = User.id (== Store.sellerId). Funded by settlement earnings.
  PLATFORM_REVENUE         // ownerId = PLATFORM_LEDGER_OWNER_ID. Commission accrual.
  PLATFORM_CASH            // ownerId = PLATFORM_LEDGER_OWNER_ID. Platform-controlled collected cash.
  PAYMENT_GATEWAY_CLEARING // ownerId = PLATFORM_LEDGER_OWNER_ID. In-flight gateway funds (speculative — see design doc §4/§12.5, no real gateway wired in yet).
  PAYOUT_CLEARING          // ownerId = PLATFORM_LEDGER_OWNER_ID. Reserved-but-not-yet-transferred seller payouts.
  // P2.9 — ownerId = PLATFORM_LEDGER_OWNER_ID. Singleton platform receivable
  // claim against sellers for delivered-order refund shortfalls (Model C —
  // see SellerPayoutLiability.originalAmount/ledgerReceivableEntryId doc
  // comments and ledger.constants.js's EVENT_ACCOUNT_MAP.REFUND comment).
  // Expected to carry a NEGATIVE Account.balance under this codebase's
  // CREDIT-increments/DEBIT-decrements convention: a new shortfall DEBITs
  // it (more negative), a recovery CREDITs it (toward zero). This is NOT
  // corruption — schema.prisma has no CHECK constraint forcing any
  // Account.balance non-negative. Added in its own migration stage (added
  // enum value only) BEFORE any application code references it — the same
  // two-stage sequencing already used for LedgerEventType.OPENING_BALANCE
  // (see the 20260814000000_ledger_opening_balance_event_type migration's
  // own comment on why a newly added Postgres enum value cannot be used in
  // the same transaction that adds it).
  PLATFORM_RECEIVABLE
}

enum LedgerAccountStatus {
  ACTIVE
  CLOSED // Reserved for future use — not produced by anything in this phase.
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

// One row per distinct financial event type this system can post, matching
// design doc §6/§7 exactly. PAYOUT_RESERVE / PAYOUT_RELEASE / PAYOUT_PROCESSED
// are deliberately three separate values sharing what will be the same
// eventId (a PayoutRequest.id) in a later phase — never one generic
// "PayoutRequest event" identity for every stage (design doc §7, Decision 5).
enum LedgerEventType {
  PAYMENT_CONFIRMED
  SETTLEMENT
  REFUND
  PAYOUT_RESERVE
  PAYOUT_RELEASE
  PAYOUT_PROCESSED
  LIABILITY_RECOVERY
  // P2.4 — reversal of a PAYMENT_CONFIRMED that never reached settlement:
  // pre-delivery cancellation only (see payments.service.js#refundWallet /
  // refundGateway's required `origin` parameter and
  // orders.service.js#markGatewayRefundProcessed's origin-based branching).
  // Never used for a delivered-order refund — that remains REFUND.
  PAYMENT_REVERSED
  // P2.5 Part B — one-time Ledger initialization for a CUSTOMER_WALLET or
  // SELLER_WALLET account whose historical financial events predate (or are
  // otherwise not safely reconstructable into) typed Ledger journals. Posted
  // exactly once per eligible account by the P2.5 opening-balance migration
  // (scripts/p2_5-opening-balance-migration.js), eventId =
  // `OPENING_BALANCE:${accountId}`. Deliberately NOT reused for, or by, any
  // other event type — it represents an accounting initialization, not a
  // reconstructed payment/refund/settlement (see that script's own header
  // comment and the P2.5 Part B decision log it references).
  OPENING_BALANCE
}

// A financial account in the double-entry sense — NOT the existing Wallet
// model, and not wired to it in this phase. See design doc §5.
model Account {
  id        String                 @id @default(uuid())
  ownerType LedgerAccountOwnerType
  // User.id for CUSTOMER_WALLET/SELLER_WALLET; PLATFORM_LEDGER_OWNER_ID
  // ("PLATFORM") for every PLATFORM_* ownerType. Deliberately a plain
  // string, not a relation — see the block comment above.
  ownerId   String
  // Explicit per design doc Decision 7 / §8 — always "TMN" (whole-unit
  // Iranian Toman, matching Decimal(12,0)'s scale) for every row produced
  // by this codebase today. No fractional-Toman subunit is introduced.
  currency  String                 @default("TMN")
  status    LedgerAccountStatus    @default(ACTIVE)
  // Cached/materialized balance (design doc §5, §11.5): SUM(CREDIT) -
  // SUM(DEBIT) of this account's LedgerEntry rows, maintained
  // transactionally alongside each LedgerEntry insert (the same
  // atomic-cache-update discipline Wallet.balance already uses).
  // Deliberately wider than LedgerEntry.amount/Decimal(12,0): a single
  // leg's amount is bounded to that range, but this column accumulates
  // an unbounded number of legs over the account's lifetime, so it needs
  // headroom beyond any single addend, not just room for one transaction.
  // Decimal(20,0) keeps the project's scale=0 whole-Toman convention while
  // giving ~10^8x headroom over the largest possible single leg amount —
  // comfortably enough for realistic lifetime accumulation without
  // resorting to an arbitrary/oversized precision.
  balance   Decimal                @default(0) @db.Decimal(20, 0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  entries LedgerEntry[]

  // Exactly one account per (owner, currency) — design doc §5's stated
  // uniqueness rule. A User with both a CUSTOMER_WALLET and a SELLER_WALLET
  // row is two separate rows here (different ownerType), not a constraint
  // violation.
  @@unique([ownerType, ownerId, currency])
  // Speeds up "does this platform account already exist" / per-owner
  // listing lookups; the unique index above already covers ownerType+ownerId
  // equality lookups as a prefix, this covers ownerId-only lookups across
  // ownerTypes (e.g. "every account this User owns, either role").
  @@index([ownerId])
  @@map("ledger_accounts")
}

// One Journal per financial event. Every Journal's LedgerEntry rows must
// balance (SUM(DEBIT) == SUM(CREDIT)) — enforced by the posting service in a
// later phase, not by anything in this schema (Postgres has no native
// per-group balance CHECK). See design doc §5, §7, §10.
model Journal {
  id        String          @id @default(uuid())
  eventType LedgerEventType
  // The domain id this Journal represents — Payment.id / OrderItemSettlement.id
  // / PaymentRefund.id (or a per-store composite) / PayoutRequest.id / a
  // deterministic recovery-event id — see design doc §7's per-event-type table.
  // Deliberately a plain string, not a polymorphic relation: the referenced
  // model differs per eventType, and this table must not gain a FK to every
  // financial model it could ever describe.
  eventId   String
  // The User who triggered this event (customer paying, admin approving a
  // payout, ...). Null for system-driven postings with no single human
  // actor. Deliberately NOT a relation to User in this phase — kept a plain
  // nullable string so this foundation migration never has to reason about
  // ON DELETE behavior against User for a table nothing writes to yet;
  // revisit if/when a later phase's posting service needs relational
  // integrity here.
  actorId   String?
  // Must match every LedgerEntry row's currency within this Journal (design
  // doc §5) — enforced by the posting service, not a DB constraint.
  currency  String          @default("TMN")
  createdAt DateTime        @default(now())

  entries LedgerEntry[]

  // Idempotency guard (design doc §7, Decision 5): the real protection
  // against duplicate postings, independent of whatever upstream
  // idempotency (PaymentRefund.idempotencyKey, PayoutRequest.idempotencyKey,
  // OrderItemSettlement.orderItemId, etc.) already exists on the source row.
  @@unique([eventType, eventId])
  @@index([eventType])
  @@index([actorId])
  @@index([createdAt])
  @@map("journals")
}

// One row per debit/credit leg. amount is always positive; `direction`
// determines the accounting effect. See design doc §5, §6, §10.
model LedgerEntry {
  id        String          @id @default(uuid())
  journalId String
  journal   Journal         @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountId String
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction LedgerDirection
  // Always positive — sign/effect comes from `direction`, matching design
  // doc §5's explicit "Amount is always positive" rule. Same Decimal(12,0)
  // convention as every other money column in this schema (whole Toman).
  amount    Decimal         @db.Decimal(12, 0)
  // Must match both journal.currency and account.currency for this row —
  // enforced by the posting service, not a DB constraint, in this phase.
  currency  String          @default("TMN")
  createdAt DateTime        @default(now())

  // P2.9 — the SellerPayoutLiability row(s) that point back at THIS entry
  // as their exact PLATFORM_RECEIVABLE DEBIT leg (see
  // SellerPayoutLiability.ledgerReceivableEntryId's own doc comment).
  // Normally at most one, but declared as a list per Prisma's standard
  // one-to-many relation shape; this entry itself is never mutated by
  // that linkage (LedgerEntry rows stay insert-only/immutable — see the
  // 20260815000000_ledger_immutability_trigger migration).
  receivableLiabilities SellerPayoutLiability[]

  // Statement / reconciliation queries (design doc §5, §10): "every entry
  // for this account, in order" is the dominant read pattern once postings
  // exist.
  @@index([accountId, createdAt])
  // "Every leg of this journal" — used to verify the debit=credit invariant
  // and to render a full journal.
  @@index([journalId])
  @@map("ledger_entries")
}

// ──────────────────────────── Support Chat / Store Chat ────────────────────────────

enum ConversationStatus {
  OPEN
  CLOSED
}

model SupportConversation {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ConversationStatus  @default(OPEN)
  // Read-state watermarks (mirrors frontend chat-service.js exactly): the
  // last time each side actually opened this conversation. A message is
  // "read" by a viewer iff message.createdAt <= the viewer's watermark.
  userReadAt  DateTime?
  adminReadAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  messages    SupportMessage[]

  @@unique([userId]) // one support conversation per user, matches frontend ChatService rule
  @@map("support_conversations")
}

enum SupportSender {
  USER
  SUPPORT
}

model SupportMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   SupportConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                 @relation(fields: [senderId], references: [id])
  from           SupportSender
  body           String
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@map("support_messages")
}

model StoreConversation {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  // Read-state watermarks, same idea as SupportConversation above.
  customerReadAt DateTime?
  storeReadAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       StoreMessage[]

  @@unique([storeId, customerId]) // one conversation per (store, customer) pair, matches frontend rule
  @@map("store_conversations")
}

enum StoreSender {
  CUSTOMER
  STORE
}

model StoreMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id])
  from           StoreSender
  body           String
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@map("store_messages")
}

// ──────────────────────────── Notifications ────────────────────────────

enum NotificationScope {
  ALL
  ROLE
  USER
}

model Notification {
  id         String            @id @default(uuid())
  icon       String?
  text       String
  actionUrl  String?
  scope      NotificationScope @default(ALL)
  targetRole RoleKey?
  targetUserId String?
  createdAt  DateTime          @default(now())

  dismissals NotificationDismissal[]
  reads      NotificationRead[]

  @@index([scope])
  @@map("notifications")
}

model NotificationDismissal {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("notification_dismissals")
}


model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

// ──────────────────────────── Hero Slider ────────────────────────────


model HeroSlide {
  id                  String    @id @default(uuid())
  title               String
  subtitle            String?
  description         String?
  desktopImageUrl     String
  mobileImageUrl      String?
  primaryButtonText   String?
  primaryButtonLink   String?
  secondaryButtonText String?
  secondaryButtonLink String?
  displayOrder        Int       @default(0)
  isActive            Boolean   @default(true)
  // Where the text/button column sits over the image on the storefront;
  // "right" matches the project's RTL default. Non-nullable with a DB-level
  // default so existing rows (created before this field existed) read as
  // "right" without a backfill step.
  contentPosition     String    @default("right")
  startAt             DateTime?
  endAt               DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isActive, displayOrder])
  @@map("hero_slides")
}

// ──────────────────────────── Admin ────────────────────────────

model AdminActivityLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_activity_log")
}